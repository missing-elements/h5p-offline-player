{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "allowJs": true,
    // `packages/`, not this package: tests/unit/revision.test.ts checks the player's fingerprint
    // against the normalizer's copy of the recipe. Nothing is emitted, so this moves no output.
    "rootDir": "..",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  // The published declarations as a caller sees them, beside the source they were written from,
  // would be two of every type: tsconfig.consumer.json checks it on its own.
  "exclude": ["tests/package-types.ts"],
  "references": []
}
