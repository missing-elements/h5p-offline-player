{
  "name": "@missing-elements/h5p-offline-player",
  "version": "0.3.1",
  "description": "Browser-only H5P player web component. Plays arbitrary .h5p archives from a URL or a local file, with no server-side extraction.",
  "license": "(MIT AND GPL-3.0-only)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/missing-elements/h5p-offline-player.git",
    "directory": "packages/player"
  },
  "homepage": "https://github.com/missing-elements/h5p-offline-player#readme",
  "bugs": {
    "url": "https://github.com/missing-elements/h5p-offline-player/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/h5p-player.js",
  "module": "./dist/h5p-player.js",
  "types": "./types/h5p-offline-player.d.ts",
  "exports": {
    ".": {
      "types": "./types/h5p-offline-player.d.ts",
      "default": "./dist/h5p-player.js"
    },
    "./sw": {
      "types": "./types/sw/mount.d.ts",
      "default": "./dist/h5p-sw-mount.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "types",
    "NOTICE.md",
    "licenses"
  ],
  "keywords": [
    "h5p",
    "h5p-player",
    "h5p-standalone",
    "h5p-viewer",
    "h5p-self-hosted",
    "h5p-offline-player",
    "web-component",
    "custom-element",
    "service-worker",
    "elearning"
  ],
  "scripts": {
    "sync:assets": "node scripts/sync-h5p-assets.mjs",
    "fixtures": "node scripts/build-fixtures.mjs",
    "prepare:dev": "pnpm sync:assets && pnpm fixtures",
    "build": "pnpm sync:assets && node -e \"for (const p of ['types', 'tsconfig.tsbuildinfo', 'node_modules/.tsc-node']) require('node:fs').rmSync(p, { recursive: true, force: true })\" && tsc -b && vite build && node scripts/build-workers.mjs && node scripts/copy-frame-assets.mjs",
    "test": "pnpm prepare:dev && vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "pnpm prepare:dev && vitest run --project browser --project browser-emulated",
    "test:watch": "pnpm prepare:dev && vitest",
    "typecheck": "tsc -b --force && tsc -p tsconfig.test.json",
    "prepack": "node scripts/prepack.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.17.0",
    "h5p-standalone": "^3.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
