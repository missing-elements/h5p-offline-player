{
  "name": "@missing-elements/h5p-verify",
  "version": "0.1.2",
  "description": "Plays an .h5p package in a headless browser through h5p-offline-player and reports whether it works: start-up, errors, missing libraries, a screenshot. The last check before a generated package is handed to anyone.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/missing-elements/h5p-offline-player.git",
    "directory": "packages/verify"
  },
  "homepage": "https://github.com/missing-elements/h5p-offline-player/tree/main/packages/verify#readme",
  "bugs": {
    "url": "https://github.com/missing-elements/h5p-offline-player/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "h5p-verify": "./bin/h5p-verify.mjs"
  },
  "exports": {
    ".": "./lib/verify.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib"
  ],
  "keywords": [
    "h5p",
    "verify",
    "test",
    "playwright",
    "headless",
    "elearning",
    "cli",
    "agent-skill"
  ],
  "scripts": {
    "test": "pnpm --filter @missing-elements/h5p-offline-player build && vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "prepublishOnly": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent || '')) { console.error('Publish with pnpm publish: npm would ship the workspace:^ dependency ranges as they are, and the package would not install.'); process.exit(1) }\" && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@missing-elements/h5p-offline-player": "workspace:^",
    "@missing-elements/h5p-runtime": "workspace:^",
    "playwright-core": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@zip.js/zip.js": "^2.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
