{
  "name": "@missing-elements/h5p-libraries",
  "version": "0.2.0",
  "description": "The H5P hub's runtime libraries for every content type it serves, for <h5p-player>'s `libraries` attribute: one archive per library, which the player fetches as a package needs them, and the whole pack as one .h5p.",
  "license": "SEE LICENSE IN libraries.txt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/missing-elements/h5p-offline-player.git",
    "directory": "packages/libraries"
  },
  "homepage": "https://github.com/missing-elements/h5p-offline-player/tree/main/packages/libraries#readme",
  "bugs": {
    "url": "https://github.com/missing-elements/h5p-offline-player/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./parts/*": "./parts/*",
    "./libraries.h5p": "./libraries.h5p",
    "./libraries.txt": "./libraries.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "parts",
    "index.js",
    "index.d.ts",
    "libraries.h5p",
    "libraries.txt"
  ],
  "keywords": [
    "h5p",
    "h5p-libraries",
    "h5p-hub",
    "h5p-offline-player"
  ],
  "scripts": {
    "build": "node ../../apps/demo/scripts/build-libraries.mjs",
    "parts": "node scripts/parts.mjs",
    "test": "node -e \"const { statSync } = require('node:fs'); for (const file of ['libraries.h5p', 'parts/index.json', 'index.js']) if (statSync(file).size < 1e3) throw new Error(file + ' is missing or empty')\""
  },
  "devDependencies": {
    "@zip.js/zip.js": "^2.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
