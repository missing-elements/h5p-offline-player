{
  "name": "@missing-elements/h5p-author",
  "version": "0.9.8",
  "description": "Builds a playable .h5p of any content type in the H5P hub's library pack from a short JSON source: only the fields that differ from the defaults, the rest filled from the libraries' own semantics and translations. For AI agents and scripts; no H5P server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/missing-elements/h5p-offline-player.git",
    "directory": "packages/author"
  },
  "homepage": "https://github.com/missing-elements/h5p-offline-player/tree/main/packages/author#readme",
  "bugs": {
    "url": "https://github.com/missing-elements/h5p-offline-player/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "h5p-author": "./bin/h5p-author.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/author.d.mts",
      "default": "./lib/author.mjs"
    },
    "./core": {
      "types": "./types/core.d.mts",
      "default": "./lib/core.mjs"
    },
    "./browser": {
      "types": "./types/browser.d.mts",
      "default": "./lib/browser.mjs"
    },
    "./references/types/*.md": "./references/types/*.md",
    "./references/authoring.md": "./references/authoring.md",
    "./SKILL.md": "./SKILL.md",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "references",
    "types",
    "SKILL.md"
  ],
  "keywords": [
    "h5p",
    "authoring",
    "generator",
    "quiz",
    "elearning",
    "ai",
    "cli",
    "agent-skill"
  ],
  "scripts": {
    "test": "pnpm --filter @missing-elements/h5p-offline-player build && vitest run",
    "test:unit": "pnpm --filter @missing-elements/h5p-offline-player build:plan && vitest run --project node",
    "typecheck": "pnpm types && tsc -p tsconfig.json",
    "sync:skill": "pnpm --filter @missing-elements/h5p-offline-player build:plan && node scripts/sync-skill.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\" && node scripts/copy-skill.mjs && pnpm types",
    "prepublishOnly": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent || '')) { console.error('Publish with pnpm publish: npm would ship the workspace: dependency ranges as they are, and the package would not install.'); process.exit(1) }\" && node scripts/check-pack-published.mjs && pnpm typecheck && pnpm test",
    "types": "pnpm --filter @missing-elements/h5p-offline-player exec tsc -b && node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\" && tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "@missing-elements/h5p-libraries": "workspace:*",
    "@missing-elements/h5p-normalize": "workspace:^",
    "@missing-elements/h5p-offline-player": "workspace:*",
    "@zip.js/zip.js": "^2.24.0"
  },
  "devDependencies": {
    "@missing-elements/h5p-verify": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
