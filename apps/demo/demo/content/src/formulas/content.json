{
  "introPage": {
    "showIntroPage": true,
    "title": "Formulas, from a content-only export",
    "startButtonText": "Start",
    "introduction": "<p>This package holds <code>h5p.json</code> and <code>content/</code> and nothing else, the way h5p.com and h5p.org export. It plays <em>untrusted</em>: none of its own code could run even if it carried some, its libraries come from this site's pack, and its content is checked against their definitions. The formulas, written as LaTeX, render because the pack carries H5P.MathDisplay and the player adds it to content that holds \\(\\LaTeX\\), as the H5P plugins do.</p>"
  },
  "progressType": "dots",
  "passPercentage": 50,
  "disableBackwardsNavigation": false,
  "randomQuestions": false,
  "endGame": {
    "showResultPage": true,
    "showSolutionButton": true,
    "showRetryButton": true,
    "noResultMessage": "Finished",
    "message": "Your result:",
    "scoreBarLabel": "You got @finals out of @totals points",
    "overallFeedback": [
      {
        "from": 0,
        "to": 49,
        "feedback": "Have a look at the &ldquo;How it works&rdquo; example, then try again."
      },
      {
        "from": 50,
        "to": 99,
        "feedback": "Most of it. The rest is in the &ldquo;How it works&rdquo; example."
      },
      {
        "from": 100,
        "to": 100,
        "feedback": "You could have written the README."
      }
    ],
    "solutionButtonText": "Show solution",
    "retryButtonText": "Retry",
    "finishButtonText": "Finish",
    "submitButtonText": "Submit",
    "showAnimations": false,
    "skippable": false
  },
  "override": {
    "checkButton": true
  },
  "questions": [
    {
      "library": "H5P.MultiChoice 1.16",
      "params": {
        "question": "<p>Which of these equals \\(\\sum_{k=1}^{n} k\\)?</p>",
        "answers": [
          {
            "text": "<div>\\(\\frac{n(n+1)}{2}\\)</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Right: the triangular numbers.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>\\(n^2\\)</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "That is the sum of the first \\(n\\) odd numbers.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>\\(2^n - 1\\)</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "That is \\(\\sum_{k=0}^{n-1} 2^k\\).",
              "notChosenFeedback": ""
            }
          }
        ],
        "behaviour": {
          "type": "single",
          "singlePoint": true,
          "randomAnswers": true,
          "enableRetry": true,
          "enableSolutionsButton": true,
          "enableCheckButton": true,
          "showSolutionsRequiresInput": true,
          "confirmCheckDialog": false,
          "confirmRetryDialog": false,
          "autoCheck": false,
          "passPercentage": 100,
          "showScorePoints": true
        },
        "overallFeedback": [
          {
            "from": 0,
            "to": 100,
            "feedback": ""
          }
        ]
      }
    },
    {
      "library": "H5P.MultiChoice 1.16",
      "params": {
        "question": "<p>Solve for \\(x\\):</p>$$x^2 - 5x + 6 = 0$$",
        "answers": [
          {
            "text": "<div>\\(x = 2\\) or \\(x = 3\\)</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Right: \\((x-2)(x-3) = 0\\).",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>\\(x = -2\\) or \\(x = -3\\)</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "The signs are the other way round.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>\\(x = 1\\) or \\(x = 6\\)</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Their product is 6, but their sum is 7.",
              "notChosenFeedback": ""
            }
          }
        ],
        "behaviour": {
          "type": "single",
          "singlePoint": true,
          "randomAnswers": true,
          "enableRetry": true,
          "enableSolutionsButton": true,
          "enableCheckButton": true,
          "showSolutionsRequiresInput": true,
          "confirmCheckDialog": false,
          "confirmRetryDialog": false,
          "autoCheck": false,
          "passPercentage": 100,
          "showScorePoints": true
        },
        "overallFeedback": [
          {
            "from": 0,
            "to": 100,
            "feedback": ""
          }
        ]
      }
    }
  ]
}