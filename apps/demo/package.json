{
  "name": "@missing-elements/h5p-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @missing-elements/h5p-offline-player prepare:dev && vite",
    "build": "pnpm --filter @missing-elements/h5p-offline-player sync:assets && node scripts/build-demo.mjs",
    "preview": "vite preview",
    "test": "pnpm --filter @missing-elements/h5p-offline-player prepare:dev && vitest run",
    "demo:content": "node scripts/build-demo-content.mjs",
    "demo:og": "node scripts/build-og-image.mjs",
    "demo:icons": "node scripts/build-app-icons.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "demo:libraries": "node scripts/build-app-libraries.mjs",
    "cmi5:catapult": "node scripts/cmi5-catapult.mjs"
  },
  "dependencies": {
    "@missing-elements/h5p-cmi5": "workspace:*",
    "@missing-elements/h5p-offline-player": "workspace:*",
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@missing-elements/h5p-normalize": "workspace:*",
    "@types/node": "^26.6.4",
    "@zip.js/zip.js": "^2.23.0",
    "playwright": "^1.50.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
