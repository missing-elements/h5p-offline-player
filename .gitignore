# Generated: the player's `sync:assets` vendors the h5p-standalone runtime into
# packages/player/public/, and its `fixtures` builds the test archives there. Both are
# reproducible from source.
public

# Copied from the repository root by the player's `prepack`, so npm finds them in the package.
packages/player/README.md
packages/player/LICENSE
# The same for the normalizer, the verifier and the cmi5 wiring, whose `prepack` copies the LICENSE.
packages/normalize/LICENSE
packages/verify/LICENSE
packages/cmi5/LICENSE

# h5p-verify writes its report and screenshot to <package>.verify/ beside the package by default.
*.verify/

# Incremental build state
*.tsbuildinfo

# Test output
tests/browser/__screenshots__
coverage

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.log

# Vitest browser-mode artefacts (failure screenshots)
.vitest/

# local agent skills
.agents/

# Generated by the runtime's build from its stylesheet's font list; `pnpm build` in packages/runtime.
packages/runtime/index.js
